# Rust

/target/
**/*.rs.bk
*.pdb

# Xcode

# The project is generated from apps/mac/project.yml; never commit it.
apps/mac/MacCV.xcodeproj/
# NOTE: apps/mac/MacCV-Info.plist is intentionally NOT ignored.
#
# It used to be generated from project.yml via xcodegen's `info:` shorthand, which
# *replaces* the target's plist configuration instead of merging with it. That silently
# discarded CFBundleIconFile, so the first release shipped with no app icon and nothing
# failed. It is now a committed source file with INFOPLIST_FILE pointing at it, and
# version values use $(MARKETING_VERSION) substitution.
*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.resolved

# The update feed is generated at deploy time by Scripts/checks/publish_feed.py, from
# the newest published release's own assets. Not committed, because a feed in the
# repository is a claim about a release that may not exist — and because a committed copy
# would be deleted by the next deploy of docs/ anyway, which is precisely what happened
# the first time.
docs/latest.json
docs/preview.json

# Generated engine artifacts
# NOTE: crates/maccv-ffi/include/maccv.h is intentionally NOT ignored. It is
# generated by cbindgen but committed, so Xcode builds and the C smoke test work
# without requiring a cbindgen install.
target/maccv-apple/

# Local build and packaging output (Scripts/build-app.sh, make-dmg.sh)
dist/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment
.env
.env.local
