# Rust

/target/
**/*.rs.bk
*.pdb

# Xcode

# The project is generated from apps/mac/project.yml; never commit it.
apps/mac/MacCV.xcodeproj/
# Info.plist is generated from project.yml's `info.properties`.
apps/mac/MacCV-Info.plist
*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.resolved

# The update feeds are written by the release workflow into the Pages artifact, not
# committed: a feed in the repository would be a claim about a release that may not
# have been published.
docs/latest.json
docs/preview.json

# Generated engine artifacts
# NOTE: crates/maccv-ffi/include/maccv.h is intentionally NOT ignored. It is
# generated by cbindgen but committed, so Xcode builds and the C smoke test work
# without requiring a cbindgen install.
target/maccv-apple/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment
.env
.env.local
