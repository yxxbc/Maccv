    "updates.signatureInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download's signature is not valid, so macOS would refuse to open it. Nothing was installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载内容的签名无效，macOS 会拒绝打开它。未安装任何内容。"
          }
        }
      }
    },
    "updates.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacCV verifies the checksum, then the code signature, and clears the quarantine flag only after both pass. That is what stops macOS reporting the new version as damaged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacCV 先校验摘要，再校验代码签名，只有两者都通过后才会清除隔离属性。这正是避免 macOS 把新版本报成「已损坏」的关键。"
          }
        }
      }
    },
    "updates.channel.title": {
      "extractionState": "manual",
