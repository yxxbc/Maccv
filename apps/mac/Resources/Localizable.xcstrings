      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "settings.privacy.masking.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mask sensitive content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感内容打码"
          }
        }
      }
    },
    "settings.privacy.masking.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide card numbers, API keys and addresses in the list. Detection is text-based and will not catch everything, so it complements — and never replaces — not recording concealed entries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表中隐藏卡号、密钥和地址。识别基于文本，无法覆盖全部情况，因此它是「不记录隐藏条目」的补充，而不能替代后者。"
          }
        }
      }
    },
    "settings.privacy.partial.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a recognisable hint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留可辨认的提示"
          }
        }
      }
    },
    "settings.privacy.partial.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the first and last few characters so you can tell entries apart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示首尾几个字符，便于区分不同记录。"
          }
        }
      }
    },
    "settings.privacy.skipConcealed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip entries hidden by other apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过其他应用标记为隐藏的条目"
          }
        }
      }
    },
    "settings.privacy.skipConcealed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password managers mark their clipboard entries concealed. Those are never recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码管理器会把剪贴板内容标记为隐藏，这些条目不会被记录。"
          }
        }
      }
    },
    "settings.privacy.securePaste.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste without the clipboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不经过剪贴板粘贴"
          }
        }
      }
    },
    "settings.privacy.securePaste.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the entry to the frontmost app as synthetic keystrokes, so it never enters the clipboard and other apps cannot read it. Slower, needs Accessibility access, and text only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把内容以合成按键直接输入到最前面的应用，因此不会进入剪贴板，其他应用无法读取。速度较慢、需要辅助功能权限，且仅适用于文本。"
          }
        }
      }
    },
    "settings.privacy.securePaste.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limited to %lld characters"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上限 %lld 个字符"
          }
        }
      }
    },
    "settings.privacy.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限"
          }
        }
      }
    },
    "settings.privacy.permission.granted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权"
          }
        }
      }
    },
    "settings.privacy.permission.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not granted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授权"
          }
        }
      }
    },
    "settings.privacy.permission.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed only for pasting without the clipboard. Everything else works without it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅「不经过剪贴板粘贴」需要，其余功能无需此权限。"
          }
        }
      }
    },
    "settings.privacy.permission.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "settings.general.limit.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries to keep"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
