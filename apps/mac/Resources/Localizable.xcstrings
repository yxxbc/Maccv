    "updates.policy.background": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download automatically, install when I say so"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动下载，由我确认安装"
          }
        }
      }
    },
    "updates.policy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading ahead makes installing feel instant. MacCV never replaces itself without your confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前下载可以让安装瞬间完成。MacCV 绝不会在未经你确认时替换自身。"
          }
        }
      }
    },
    "updates.check": {
      "extractionState": "manual",
      "localizations": {
