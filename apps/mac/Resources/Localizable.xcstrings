    "updates.revoked.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build was released with a defect serious enough that it should not keep running. Update to continue safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本存在严重缺陷，不应继续使用。请更新后继续使用。"
          }
        }
      }
    },
    "updates.revoked.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version has been withdrawn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本已被撤回"
          }
        }
      }
    },
    "updates.revoked.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacCV %@ was released with a defect that could not wait for a routine update. It needs to be replaced before it is used again — your clipboard history stays on this Mac either way."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacCV %@ 的缺陷无法等到常规更新周期处理，需要替换后才能继续使用。无论是否更新，你的剪贴板记录都只保存在这台 Mac 上。"
          }
        }
      }
    },
    "updates.revoked.updateNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
