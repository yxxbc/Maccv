          }
        }
      }
    },
    "settings.general.limit.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History lives in memory only and is cleared when MacCV quits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录仅保存在内存中，退出 MacCV 后清空。"
          }
        }
      }
    },
